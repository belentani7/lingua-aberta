{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/study/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/games",
      "destination": "/index.html"
    },
    {
      "source": "/games/:game",
      "destination": "/index.html"
    },
    {
      "source": "/404",
      "destination": "/index.html"
    }
  ]
}
